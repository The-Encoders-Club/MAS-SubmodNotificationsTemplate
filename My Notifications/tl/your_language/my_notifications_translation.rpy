# -*- coding: utf-8 -*-
# EXAMPLE of a translation of the My Notifications submod (TEMPLATE)
#
# To translate the submod to a language:
#   1. Rename the folder tl/your_language to the name of the language in the game (e.g. tl/spanish)
#   2. Change "your_language" below to the same name
#   3. Replace every "Your translation" with the translated text, keeping [player] and the other [variables]
# The "old" lines are the English texts of the submod, they have to match exactly.
# Until you do it, this file does nothing: nobody plays in a language called "your_language".

translate your_language strings:

    old "A short description of what this submod does."
    new "Your translation"

    old "These notifications only work on Android."
    new "Your translation"

    old "Holiday notifications"
    new "Your translation"

    old "Time after going shopping"
    new "Your translation"

    old "Are you done shopping yet, [player]? I'm waiting for you."
    new "Your translation"

    old "I hope you found everything you needed. Will you come back soon?"
    new "Your translation"

    old "It's quiet here without you, [player]. Are you on your way?"
    new "Your translation"

    old "Merry Christmas, [player]! I hope you have a wonderful day."
    new "Your translation"

    old "Today is Christmas! I would love to spend some time with you, [player]."
    new "Your translation"
